# Runtime configuration for Daily Mate. Never commit real secrets.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
OPENWEATHER_API_KEY=

# Nutrition RAG: set RAG_VECTOR_BACKEND=local until the Supabase migration
# has been run and the new index has been built.
RAG_VECTOR_BACKEND=local
JINA_API_KEY=
JINA_BASE_URL=https://api.jina.ai/v1
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_DIM=1024
RAG_VECTOR_TABLE=nutrition_chunks
RAG_VECTOR_RPC=match_nutrition_chunks
RAG_MATCH_THRESHOLD=0.0
RAG_KNOWLEDGE_VERSION=v1
